# Copy this file to secrets.yaml (next to the device YAML, or merge it into the
# secrets.yaml that the ESPHome Device Builder add-on already uses) and fill it in.
# Never commit the real secrets.yaml.

wifi_ssid: "your-wifi-name"
wifi_password: "your-wifi-password"

# 32-byte base64 key. Generate one with:
#   python3 -c "import secrets,base64;print(base64.b64encode(secrets.token_bytes(32)).decode())"
# or copy the key the ESPHome Device Builder generates for a new device.
api_encryption_key: "REPLACE_WITH_YOUR_BASE64_KEY"

ota_password: "choose-an-ota-password"
fallback_ap_password: "choose-a-fallback-password"
